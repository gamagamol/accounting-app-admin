APP_NAME=admin-accounting-backend
APP_ENV=development
APP_PORT=8080

# Logging: debug | info | warn | error
# RUST_LOG can override LOG_LEVEL when set.
LOG_LEVEL=info
# Logging: json | text
LOG_FORMAT=json

# Database: memory (default, no Postgres needed) | postgres
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin_accounting
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Redis is optional for the first CRUD boilerplate.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
