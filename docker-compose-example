name: admin-accounting

services:
  postgres:
    image: postgres:16-alpine
    container_name: admin-accounting-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-admin_accounting}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-admin_accounting}"
        ]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - accounting

  redis:
    image: redis:7-alpine
    container_name: admin-accounting-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks:
      - accounting

  mongo:
    image: mongo:7
    container_name: admin-accounting-mongo
    restart: unless-stopped
    ports:
      - "${MONGO_PORT:-27017}:27017"
    volumes:
      - mongo_data:/data/db
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - accounting

  backend:
    build:
      context: ./admin-accounting-backend
      dockerfile: Dockerfile
    container_name: admin-accounting-backend
    restart: unless-stopped
    env_file:
      - path: ./admin-accounting-backend/.env
        required: false
    environment:
      APP_NAME: admin-accounting-backend
      APP_ENV: production
      APP_PORT: 8080
      RUST_LOG: ${RUST_LOG:-info}
      DB_DRIVER: postgres
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB:-admin_accounting}
      DB_USER: ${POSTGRES_USER:-postgres}
      DB_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      DB_SSLMODE: disable
      REDIS_ENABLED: "true"
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_DB: 0
      MONGO_ENABLED: "true"
      MONGO_URI: mongodb://mongo:27017
      MONGO_DATABASE: ${MONGO_DATABASE:-admin_accounting}
      MONGO_AUDIT_COLLECTION: ${MONGO_AUDIT_COLLECTION:-audit_logs}
      TZ: Asia/Jakarta
    ports:
      - "${BACKEND_PORT:-8080}:8080"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      mongo:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/health"]
      interval: 10s
      timeout: 5s
      start_period: 15s
      retries: 10
    networks:
      - accounting

  frontend:
    build:
      context: ./admin-accounting-frontend
      dockerfile: Dockerfile
      args:
        VITE_API_BASE_URL: ${VITE_API_BASE_URL:-http://localhost:8080}
    container_name: admin-accounting-frontend
    restart: unless-stopped
    env_file:
      - path: ./admin-accounting-frontend/.env
        required: false
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: 3000
      ORIGIN: ${FRONTEND_ORIGIN:-http://localhost:3000}
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3000/"]
      interval: 10s
      timeout: 5s
      start_period: 15s
      retries: 10
    networks:
      - accounting

volumes:
  postgres_data:
  redis_data:
  mongo_data:

networks:
  accounting:
    driver: bridge
