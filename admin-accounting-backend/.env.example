APP_NAME=admin-accounting-backend
APP_ENV=development
APP_PORT=8080

LOG_LEVEL=info
RUST_LOG=info

# Kosongkan untuk menonaktifkan validasi JWT (mode development/test)
JWT_SECRET=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_admin_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accounting_admin_db?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=admin_accounting
MONGO_AUDIT_COLLECTION=audit_logs
