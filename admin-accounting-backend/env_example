APP_NAME=admin-accounting-backend
APP_ENV=development
APP_PORT=8080

# Logging uses Rust's default tracing subscriber (plain text).
# RUST_LOG overrides LOG_LEVEL when set.
LOG_LEVEL=info
RUST_LOG=info

# Database: memory (default, no Postgres needed) | postgres
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin_accounting
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Redis is optional for the first CRUD boilerplate.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB stores the immutable audit trail (no PostgreSQL audit table).
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=admin_accounting
MONGO_AUDIT_COLLECTION=audit_logs
